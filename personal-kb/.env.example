# LLM Fallback Order (Groq -> Gemini -> OpenRouter)
LLM_FALLBACK_ORDER=groq,gemini,openrouter

# 1. Groq Configuration (Primary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 2. Google Gemini Configuration (First Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 3. OpenRouter Configuration (Second Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama Configuration (Embeddings & Optional Local Fallback)
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=embeddinggemma

# Qdrant Vector Store Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=personal_knowledge

# Data and Ingestion Configuration
DATA_DIR=data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K=5
RERANK_TOP_K=3

# Observability
LOG_LEVEL=INFO
